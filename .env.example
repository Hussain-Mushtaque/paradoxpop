# Copy to .env (gitignored). Every provider defaults to "mock", which costs nothing.
PARADOXPOP_LLM=mock            # mock | meta
PARADOXPOP_LLM_MODEL=muse-spark-1.3
MODEL_API_KEY=                 # Meta Model API key (dev.meta.ai), only needed when PARADOXPOP_LLM=meta
PARADOXPOP_VOICE=mock
PARADOXPOP_VIDEO=mock
PARADOXPOP_BUDGET_USD=5        # hard cap on total recorded spend
PARADOXPOP_APPROVAL_THRESHOLD_USD=1   # video spend above this needs --approve
